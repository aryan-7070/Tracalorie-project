{
  "name": "tracalorie-server",
  "version": "2.0.0",
  "description": "Tracalorie API — calorie tracking with defence-in-depth security, hash-chained audit logging and encrypted PII",
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "migrate": "node migrate.js up",
    "migrate:status": "node migrate.js status",
    "migrate:fresh": "node migrate.js fresh",
    "setup": "node migrate.js up",
    "start": "node index.js",
    "dev": "nodemon --watch . --ext js,json,sql index.js",
    "test": "node --test --test-concurrency=1 test/",
    "lint": "node scripts/lint-syntax.js",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "secrets:generate": "node scripts/generate-secrets.js"
  },
  "keywords": [
    "calorie-tracker",
    "express",
    "postgres",
    "security"
  ],
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
