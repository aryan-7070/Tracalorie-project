# =============================================================================
# Tracalorie API — environment template
#
# Copy to .env for local development:      cp .env.example .env
# Generate real secrets:                  npm run secrets:generate
#
# The server validates this file at startup and REFUSES TO BOOT on a missing or
# unsafe value. That is deliberate: a half-configured process that starts and
# then serves traffic insecurely is far worse than one that fails fast.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=5000
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
# Trust exactly this many reverse proxies. Must match your real topology:
#   local dev        -> false
#   1 load balancer  -> 1
# Wrong in either direction breaks rate limiting and audit IPs.
TRUST_PROXY=false
# Reject request bodies larger than this (bytes). Small by design.
BODY_LIMIT=16kb

# --- Secrets (REQUIRED) ------------------------------------------------------
# Generate all three with: npm run secrets:generate
# In production, use Google Secret Manager / AWS SSM / Vault — not a .env file.
#
# JWT_SECRET          min 32 chars. Signs access tokens.
# PII_ENCRYPTION_KEY  AES-256-GCM key for field-level encryption of email and
#                     display name. 32 bytes hex, or 32 bytes base64, or a
#                     passphrase that gets scrypt-derived.
# BLIND_INDEX_KEY     HMAC key for searchable-but-encrypted columns. Changing
#                     this makes existing users unreachable by email/username.
#
# Rotating PII_ENCRYPTION_KEY or BLIND_INDEX_KEY requires re-encrypting every
# row. Plan that as a migration, not a restart.
JWT_SECRET=replace-me-with-output-of-npm-run-secrets-generate
PII_ENCRYPTION_KEY=replace-me-with-output-of-npm-run-secrets-generate
BLIND_INDEX_KEY=replace-me-with-output-of-npm-run-secrets-generate

# --- Database ----------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=tracalorie
PGUSER=postgres
PGPASSWORD=tracalorie_dev_password
PGPOOL_MAX=10
PG_CONNECT_TIMEOUT_MS=10000
# Server-side query ceiling. Bounds the blast radius of a pathological query.
PG_STATEMENT_TIMEOUT_MS=15000
# Set to `require` in production; the server refuses to start without it.
PGSSLMODE=disable
# Path to a CA bundle, needed for managed Postgres whose cert is not in the
# system trust store (Cloud SQL, Neon, Supabase, RDS).
# PGSSLROOTCERT=/etc/ssl/certs/gcp-postgres-root.crt
# PG_SSL_REJECT_UNAUTHORIZED=true

# --- CORS --------------------------------------------------------------------
# Comma-separated exact origin allowlist. REQUIRED in production — a wildcard
# with credentials is rejected at startup.
CORS_ORIGINS=http://localhost:3000

# --- Cookies -----------------------------------------------------------------
# In production these are forced on: Secure, and the __Host- prefix.
# COOKIE_SECURE=true
# COOKIE_PREFIX=__Host-
COOKIE_SAMESITE=strict
# COOKIE_DOMAIN=.example.com   # only if you need a shared subdomain

# --- Passwords ---------------------------------------------------------------
# Cost factor. Each +1 doubles CPU. 12 is the current OWASP recommendation;
# raise it as hardware improves. Minimum 10 is enforced.
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12
# Recent passwords that cannot be reused.
# (history depth is fixed at 5)

# --- Brute-force lockout -----------------------------------------------------
# After LOGIN_LOCKOUT_THRESHOLD consecutive failures the account is blocked for
# LOGIN_LOCKOUT_BASE_SECONDS, doubling per further failure up to the max.
# Progressive rather than a hard N-strike lockout, which is trivially weaponised
# as a denial of service against a known victim.
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_BASE_SECONDS=30
LOGIN_LOCKOUT_MAX_SECONDS=3600

# --- Sessions ----------------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Hard ceiling on a session's life. Rotation never extends this.
SESSION_ABSOLUTE_LIFETIME_SECONDS=7776000

# --- Rate limits (per instance; the edge enforces the global budget) ---------
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_WRITE_WINDOW_MS=60000
RATE_LIMIT_WRITE_MAX=60

# --- Google Cloud Storage (OPTIONAL) -----------------------------------------
# Enables POST /api/security/export/archive, which stores an AES-256-GCM
# encrypted copy of a user's data in a bucket they cannot read directly.
# Leave unset to disable; exports are then delivered inline only.
#
# The service account needs exactly one role on the bucket:
#   roles/storage.objectCreator   (create objects, cannot read them)
#
# GCS_EXPORT_BUCKET=my-tracalorie-exports
# GCS_EXPORT_PREFIX=exports
# GCS_CLIENT_EMAIL=tracalorie-exports@my-project.iam.gserviceaccount.com
# GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional customer-managed encryption key; without it Google uses its default.
# GCS_KMS_KEY=projects/my-project/locations/global/keyRings/tracalorie/cryptoKeys/exports
